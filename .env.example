# Copia este archivo a .env para desarrollo local.
# En Netlify, configura estas mismas variables en:
# Panel de control del sitio -> Site configuration -> Environment variables

# Connection string de PostgreSQL en la nube (Supabase/Neon)
DATABASE_URL=postgres://usuario:password@host:puerto/basededatos

# Clave secreta para firmar los tokens JWT (cadena aleatoria larga)
JWT_SECRET=genera_una_cadena_aleatoria_muy_larga_y_segura

# Puerto para el servidor local (opcional)
PORT=3000
